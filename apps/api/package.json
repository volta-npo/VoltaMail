{
  "name": "@email-automation/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "start": "node dist/main.js",
    "build": "pnpm --filter @email-automation/database db:generate && tsc -p tsconfig.build.json && mkdir -p api/dist && cp -R dist/. api/dist/",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@email-automation/database": "workspace:*",
    "@email-automation/shared": "workspace:^",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "csv-parse": "^5.5.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "multer": "^1.4.5-lts.1",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1"
  }
}
